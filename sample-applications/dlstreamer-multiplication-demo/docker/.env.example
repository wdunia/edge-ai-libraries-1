# Prebuilt images only. No local docker build is used by docker-compose.images.yml.
#
# This is a TEMPLATE file (tracked in git). The actual runtime file docker/.env
# is generated from this template on first run and is git-ignored, because it
# will contain a locally-generated TURN password (not meant to be committed).
DLSTREAMER_PIPELINE_SERVER_IMAGE=intel/dlstreamer-pipeline-server:2026.1.0-ubuntu24

# These two images are NOT published to any public registry.
# Build them once locally with: ./scripts/build_demo_images.sh
# (self-contained: only uses files in this folder, no microservices/ dependency)
DLSTREAMER_DEMO_BE_IMAGE=dlstreamer-multiplication-demo-be:local
DLSTREAMER_DEMO_UI_IMAGE=dlstreamer-multiplication-demo-ui:local

# Runtime variables
ip=127.0.0.1

# Host port for the demo UI (container always listens on 8103).
UI_PORT=8103

# Optional proxy bypass for in-stack Docker services. Extend this if your host
# injects HTTP(S)_PROXY into containers.
CONTAINER_NO_PROXY=localhost,127.0.0.1,host.docker.internal,dlstreamer-pipeline-server,mqtt-broker,mediamtx,coturn,metrics-manager

MQTT_HOST=mqtt-broker
MQTT_PORT=1883
LOG_LEVEL=INFO

# GUI default form values (written by run_dlStreamer.sh into VITE_* variables)
DLSPS_SOURCE_MODE=file
VITE_SYSTEM_INFO=CPU/GPU/NPU telemetry via prebuilt images
DEFAULT_STREAM_NAME=CAM-01
DEFAULT_RTSP_SOURCE_URL=rtsp://host.docker.internal:8554/camera0
DEFAULT_INSTANCE_COUNT=1
DEFAULT_INFERENCE_INTERVAL=1
DEFAULT_INFERENCE_RESOLUTION=2/3
# Global GUI/backend default for model sharing. Per-device values below are
# still supported as fallbacks when this key is omitted.
DLSPS_SHARE_MODEL_INSTANCE=false

# Model Registry (optional)
MR_URL=
MR_SAVED_MODELS_DIR=
MR_REQUEST_TIMEOUT=
MR_VERIFY_CERT=/run/secrets/ModelRegistry_Server/ca-bundle.crt

# OpenTelemetry (optional)
ENABLE_OPEN_TELEMETRY=false
OTEL_COLLECTOR_HOST=otel-collector
OTEL_COLLECTOR_PORT=4318
OTEL_EXPORT_INTERVAL_MILLIS=5000

# WebRTC
WHIP_SERVER_IP=127.0.0.1
WHIP_SERVER_PORT=8889
WHIP_SERVER_TIMEOUT=10s
# TURN server credentials. Do NOT keep these placeholder values in a real
# deployment. run_dlStreamer.sh auto-generates a random password on first
# run when docker/.env does not exist yet (it copies this file and rewrites
# the password). Change the username too if you want non-default values.
MTX_WEBRTCICESERVERS2_0_USERNAME=CHANGE_ME_USERNAME
MTX_WEBRTCICESERVERS2_0_PASSWORD=CHANGE_ME_PASSWORD

# Render group ID required to access GPU/NPU device nodes inside container
RENDER_GID=992

# Backend timeout tuning
PIPELINE_SERVER_TIMEOUT=30
PIPELINE_DELETE_TIMEOUT=8
PIPELINE_STOP_WAIT_TIMEOUT=8
PIPELINE_STOP_POLL_INTERVAL=0.5
PIPELINE_ADD_MAX_WORKERS=3

# Pipeline tuning (consumed by sample-applications/dlstreamer-multiplication-demo/app/stream.py)
DLSPS_CPU_INFERENCE_INTERVAL=1

# GPU tuning
DLSPS_GPU_PRE_PROCESS_BACKEND=va-surface-sharing
DLSPS_GPU_INFERENCE_REGION=full-frame
DLSPS_GPU_INFERENCE_INTERVAL=1
DLSPS_GPU_BATCH_SIZE=1
DLSPS_GPU_NIREQ=1
DLSPS_GPU_IE_CONFIG=GPU_THROUGHPUT_STREAMS=1
DLSPS_GPU_THRESHOLD=0.7
DLSPS_GPU_SHARE_MODEL_INSTANCE=false

# NPU tuning
DLSPS_NPU_PRE_PROCESS_BACKEND=va
DLSPS_NPU_INFERENCE_INTERVAL=1
DLSPS_NPU_BATCH_SIZE=1
DLSPS_NPU_NIREQ=1
DLSPS_NPU_SHARE_MODEL_INSTANCE=false
