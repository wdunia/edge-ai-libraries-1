+    start_time = time.time()
+    
+    async def timed_generator():
+        last_chunk_time = start_time
+        
+        try:
+            async for chunk in generator_func(*args, **kwargs):
+                last_chunk_time = time.time()
+                yield chunk
+            
+            # Add timing info
+            total_time = round((last_chunk_time - start_time) * 1000, 2)
