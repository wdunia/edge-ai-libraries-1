# Local Chat Bot demo - central configuration.
# Every value can be overridden by exporting it before running the scripts.

# --- Baseline of the untouched sample application -----------------------------
# Commit used to generate patches/ and overlay/MANIFEST.sha256.
# It is the merge-base of this repository's main branch and the demo branch.
UPSTREAM_REF="${UPSTREAM_REF:-9ef3f218ac03204546d840878d608ce3c1185fb6}"
UPSTREAM_REPO_URL="${UPSTREAM_REPO_URL:-https://github.com/open-edge-platform/edge-ai-libraries.git}"
APP_REL_PATH="${APP_REL_PATH:-sample-applications/chat-question-and-answer}"

# --- Working copy -------------------------------------------------------------
# The sample application is NEVER modified in place; it is copied here first.
WORK_ROOT="${WORK_ROOT:-${DEMO_ROOT}/.work}"
WORK_DIR="${WORK_DIR:-${WORK_ROOT}/chat-question-and-answer}"
LOG_DIR="${LOG_DIR:-${DEMO_ROOT}/logs}"

# --- Persistent caches (survive --clean and workspace recreation) -------------
# Converted OVMS models. Kept OUTSIDE .work so that recreating the working copy
# never triggers a new multi-hour download/convert cycle.
OVMS_MODELS_DIR="${OVMS_MODELS_DIR:-${DEMO_ROOT}/.cache/ovms}"
# Chrome profile of the ChatGPT window: keeps the login between demo runs.
CHATGPT_PROFILE_DIR="${CHATGPT_PROFILE_DIR:-${DEMO_ROOT}/.cache/chrome-gpt}"

# --- Prompt console -----------------------------------------------------------
# Served by tools/autorun.py on the loopback interface only.
PROMPT_CONSOLE_PORT="${PROMPT_CONSOLE_PORT:-8102}"
PROMPT_CONSOLE_HEIGHT_PCT="${PROMPT_CONSOLE_HEIGHT_PCT:-22}"

# --- Demo images (built locally, never pushed) --------------------------------
DEMO_BE_IMAGE="${DEMO_BE_IMAGE:-local-chat-bot-be:local}"
DEMO_UI_IMAGE="${DEMO_UI_IMAGE:-local-chat-bot-ui:local}"
COMPOSE_PROJECT_NAME="${COMPOSE_PROJECT_NAME:-local-chat-bot}"

# --- Runtime configuration ----------------------------------------------------
LLM_MODEL="${LLM_MODEL:-OpenVINO/gpt-oss-20b-int4-ov}"
EMBEDDING_MODEL_NAME="${EMBEDDING_MODEL_NAME:-nomic-ai/nomic-embed-text-v1.5}"
RERANKER_MODEL="${RERANKER_MODEL:-BAAI/bge-reranker-base}"
DEMO_MAX_TOKENS="${DEMO_MAX_TOKENS:-32768}"
SYSTEM_INFO_TEXT="${SYSTEM_INFO_TEXT:-CPU: Intel Core i7 265H | GPU: Intel Arc B350 | NPU: Intel Ai Boost | RAM: 64GB}"
MAX_WAIT_SECONDS="${MAX_WAIT_SECONDS:-1800}"

# --- model-download microservice ---------------------------------------------
MODEL_DOWNLOAD_MODEL_PATH="${MODEL_DOWNLOAD_MODEL_PATH:-${HOME}/host_path}"
MODEL_DOWNLOAD_IMAGE="${MODEL_DOWNLOAD_IMAGE:-intel/model-download:latest}"
MODEL_DOWNLOAD_PLUGINS="${MODEL_DOWNLOAD_PLUGINS:-openvino}"
MODEL_DOWNLOAD_PORT="${MODEL_DOWNLOAD_PORT:-8200}"
MODEL_DOWNLOAD_JOB_MAX_ATTEMPTS="${MODEL_DOWNLOAD_JOB_MAX_ATTEMPTS:-240}"
MODEL_DOWNLOAD_STATUS_LOG_EVERY="${MODEL_DOWNLOAD_STATUS_LOG_EVERY:-10}"
MODEL_DOWNLOAD_PULL_POLICY="${MODEL_DOWNLOAD_PULL_POLICY:-if-missing}"

# --- metrics-manager microservice --------------------------------------------
METRICS_MANAGER_IMAGE="${METRICS_MANAGER_IMAGE:-intel/metrics-manager:2026.1.0-20260508-weekly}"

